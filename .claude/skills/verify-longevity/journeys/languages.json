{
  "name": "languages",
  "steps": [
    { "go": "/zh/studies/coffee/" },
    { "click": "summary.site-lang__trigger" },
    { "expect": "document.querySelector('.site-lang__details').open", "label": "language menu open" },
    { "shot": "menu-open", "viewport": true },
    { "click": ".xxd-menu__item[hreflang='en']", "nav": true },
    { "expect": "location.pathname === '/en/studies/coffee/' && document.documentElement.lang === 'en'", "label": "same study in English" },
    { "click": "summary.site-lang__trigger" },
    { "press": "Escape" },
    { "expect": "!document.querySelector('.site-lang__details').open", "label": "Escape closes the menu" },
    { "go": "/ar/studies/coffee/" },
    { "expect": "document.documentElement.dir === 'rtl' && document.documentElement.lang === 'ar'", "label": "Arabic is right to left" },
    { "shot": "ar-coffee" },
    { "go": "/", "acceptLanguage": "zh-CN,zh;q=0.9" },
    { "waitFor": "location.pathname === '/zh/'", "timeout": 5000 },
    { "go": "/", "acceptLanguage": "fr-FR,fr;q=0.9" },
    { "waitFor": "location.pathname === '/fr/'", "timeout": 5000 },
    { "go": "/", "acceptLanguage": "ko-KR,ko;q=0.9" },
    { "waitFor": "location.pathname === '/en/'", "timeout": 5000 },
    { "go": "/", "noScript": true },
    { "expect": "document.querySelectorAll('a[hreflang]').length >= 8", "label": "without JS the root lists every language" },
    { "snapshot": "root-nojs" }
  ]
}
